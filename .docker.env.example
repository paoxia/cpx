# Agent System Docker 环境变量
# 复制为 .docker.env 并填写真实值
# 部署后通过 `docker compose up -d` 重启容器即可应用新配置

# === 服务 ===
AGENT_SERVER_PORT=3000
AGENT_SERVER_HOST=0.0.0.0

# === 出站代理（可选）===
# 必须填写容器可访问的局域网地址，不能使用 127.0.0.1 或 localhost。
# HTTP 代理示例：http://192.168.1.10:7890
HTTP_PROXY=
HTTPS_PROXY=
# 仅使用 SOCKS5 时填写，例如 socks5h://192.168.1.10:7891
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1

# === NAS 内置 Mihomo 方案（仅 docker-compose.mihomo.yml 使用）===
# 开发迭代可把 CPX_IMAGE 改为 cpx:dev；Mihomo 默认版本与 Compose 文件保持一致。
CPX_IMAGE=cpx:latest
MIHOMO_IMAGE=metacubex/mihomo:v1.19.30

# === 系统包与 npm 构建源（可选，仅镜像构建阶段使用）===
# 国内开发机可分别改为 http://mirrors.aliyun.com 和 https://registry.npmmirror.com
APT_MIRROR=http://deb.debian.org
NPM_REGISTRY=https://registry.npmjs.org

# === Codex API Key（可选；推荐启动后在 Agent 设置中完成官方 CLI 登录）===
# 页面从登录账号的 Codex 模型目录中选择模型，不在方案中保存密钥。
# Codex 单次非交互执行使用
CODEX_API_KEY=

# === GitHub（创建 PR 必需）===
# gh CLI 鉴权用，与 AGENT_GITHUB_TOKEN 通常相同
GH_TOKEN=
# cpx 读取的 GitHub Token
AGENT_GITHUB_TOKEN=
# 默认仓库（可留空，Web 控制台每次任务会显式指定）
AGENT_GITHUB_DEFAULT_REPO=

# === 钉钉 Stream 长连接机器人（可选）===
AGENT_DINGTALK_ENABLED=false
AGENT_DINGTALK_CLIENT_ID=
AGENT_DINGTALK_CLIENT_SECRET=

# === 飞书 WebSocket 长连接机器人（可选）===
AGENT_FEISHU_ENABLED=false
AGENT_FEISHU_APP_ID=
AGENT_FEISHU_APP_SECRET=

# === 日志级别：debug | info | warn | error ===
AGENT_LOGGING_LEVEL=info

# === 可选：SQLite 数据库路径（默认 /app/data/agent.db）===
# AGENT_STORAGE_PATH=/app/data/agent.db
