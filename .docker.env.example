# Agent System Docker 环境变量
# 复制为 .docker.env 并填写真实值
# 部署后通过 `docker compose up -d` 重启容器即可应用新配置

# === 服务 ===
AGENT_SERVER_PORT=3000
AGENT_SERVER_HOST=0.0.0.0

# === Agent API Key（可选；也可在模型设置中逐项保存或完成官方 CLI 登录）===
# 自定义网关 Base URL 在 Web 控制台的每条模型配置中填写
# Codex 单次非交互执行使用
CODEX_API_KEY=sk-...
# Claude Code 使用
ANTHROPIC_API_KEY=sk-ant-...

# === GitHub（创建 PR 必需）===
# gh CLI 鉴权用，与 AGENT_GITHUB_TOKEN 通常相同
GH_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# cpx 读取的 GitHub Token
AGENT_GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# 默认仓库（可留空，Web 控制台每次任务会显式指定）
AGENT_GITHUB_DEFAULT_REPO=owner/repo

# === 钉钉机器人（可选）===
AGENT_DINGTALK_WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
AGENT_DINGTALK_SECRET=SECxxx

# === 飞书机器人（可选）===
AGENT_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
AGENT_FEISHU_APP_ID=cli_xxx
AGENT_FEISHU_APP_SECRET=xxx

# === 日志级别：debug | info | warn | error ===
AGENT_LOGGING_LEVEL=info

# === 可选：SQLite 数据库路径（默认 /app/data/agent.db）===
# AGENT_STORAGE_PATH=/app/data/agent.db
